# HTTP → HTTPS редирект (локально)
:80 {
	redir https://{host}{uri}
}

# HTTPS локально (self-signed от Caddy CA)
:443 {
	encode gzip
	# Кэш для статики
	@static {
		path *.js *.css *.png *.svg *.jpg *.jpeg *.webp *.woff2
	}
	header @static {
		Cache-Control "public, max-age=31536000, immutable"
	}
	tls internal
	reverse_proxy web:3000
}

# Дополнительно: HTTPS на 3000 (локально)
:3000 {
	tls internal
	reverse_proxy web:3000
}
